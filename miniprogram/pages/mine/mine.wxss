.mine-page {
  padding: 24rpx 24rpx 50rpx;
}

.profile-card {
  background: #1f1f1c;
  color: #fff;
  border-radius: 30rpx;
  padding: 30rpx 28rpx 26rpx;
  margin-bottom: 28rpx;
}

.profile-eyebrow {
  font-size: 21rpx;
  opacity: 0.55;
}

.profile-title {
  font-size: 46rpx;
  font-weight: 700;
  margin-top: 8rpx;
  letter-spacing: -1rpx;
}

.profile-sub {
  font-size: 22rpx;
  opacity: 0.6;
  margin-top: 6rpx;
}

.stats {
  display: flex;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stat-label {
  font-size: 20rpx;
  opacity: 0.55;
  margin-top: 4rpx;
}

.menu-card {
  background: var(--card);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
}

.menu-row + .menu-row {
  border-top: 1rpx solid var(--line);
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.menu-hint {
  display: block;
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.menu-value {
  font-size: 22rpx;
  color: var(--muted);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.chevron {
  font-size: 34rpx;
  color: #c3c3bc;
  margin-left: 10rpx;
  line-height: 1;
}

.footer {
  text-align: center;
  font-size: 20rpx;
  color: #b4b4ad;
  margin-top: 40rpx;
}

.contact-row {
  position: relative;
}

.contact-hit {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  /* 微信 button 自带默认宽度，必须强制撑满，否则只有中间可点 */
  width: 100% !important;
  height: 100% !important;
  min-width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none;
  border-radius: 0;
  background: transparent;
  /* 完全透明在部分机型上会丢失点击，保留极低透明度 */
  opacity: 0.01;
  z-index: 10;
  box-sizing: border-box;
}

.contact-hit::after {
  border: none;
}
