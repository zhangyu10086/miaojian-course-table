.admin-page {
  padding: 28rpx 24rpx 60rpx;
}

.admin-head {
  padding: 0 6rpx 24rpx;
}

.admin-title {
  font-size: 40rpx;
  font-weight: 700;
}

.admin-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  line-height: 1.5;
}

.admin-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx 26rpx;
}

.admin-status {
  font-size: 26rpx;
  color: var(--muted);
  text-align: center;
  padding: 50rpx 26rpx;
}

.admin-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 24rpx;
}

.openid-box {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  padding: 16rpx 18rpx;
  background: var(--soft);
  border-radius: 14rpx;
}

.openid-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  word-break: break-all;
}

.admin-btn {
  margin-top: 24rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--muted);
  margin: 22rpx 0 10rpx;
}

.field-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 18rpx;
  font-size: 27rpx;
  background: var(--soft);
  border-radius: 14rpx;
}

.field-hint {
  font-size: 20rpx;
  color: var(--muted);
  margin: 8rpx 4rpx 0;
  line-height: 1.5;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.switch-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.switch-title {
  font-size: 27rpx;
  font-weight: 500;
}

.switch-desc {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 6rpx;
  line-height: 1.5;
}

.form-actions {
  display: flex;
  margin-top: 32rpx;
}

.form-action {
  flex: 1;
}

.form-action + .form-action {
  margin-left: 16rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  background: var(--card);
  border-radius: 18rpx;
}

.add-btn {
  flex-shrink: 0;
  width: 190rpx;
  height: 84rpx;
  line-height: 84rpx;
  margin-left: 14rpx;
  font-size: 27rpx;
  border-radius: 18rpx;
}

.school-list {
  margin-top: 4rpx;
}

.manage-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
}

.manage-head {
  display: flex;
  align-items: center;
}

.manage-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  font-weight: 600;
}

.tag {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
}

.tag.secure {
  background: #e6f2ea;
  color: #2f6b45;
}

.tag.manual {
  background: var(--soft);
  color: var(--muted);
}

.tag.default {
  background: #fff3d6;
  color: #9a5b00;
}

.tag.verified {
  background: #e6f2ea;
  color: #2f6b45;
}

.tag.pending {
  background: #fff3d6;
  color: #9a5b00;
}

.manage-meta {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 6rpx;
  word-break: break-all;
}

.manage-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.manage-btn {
  font-size: 21rpx;
  color: var(--text);
  background: var(--soft);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  margin-left: 10rpx;
}

.admin-foot {
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 22rpx;
  line-height: 1.7;
}
