.privacy-page {
  padding: 28rpx 24rpx 60rpx;
}

.privacy-head {
  padding: 0 6rpx 24rpx;
}

.privacy-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.privacy-updated {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.privacy-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
}

.section-title {
  font-size: 27rpx;
  font-weight: 600;
  margin: 30rpx 6rpx 12rpx;
}

.p {
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--text);
}

.p + .p {
  margin-top: 14rpx;
}

.strong {
  font-weight: 600;
}

.privacy-foot {
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 40rpx;
}
