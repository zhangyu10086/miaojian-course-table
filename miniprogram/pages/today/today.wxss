.today-page {
  padding: 24rpx 24rpx 50rpx;
}

.today-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.today-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.today-sub {
  font-size: 23rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.now {
  font-size: 26rpx;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff4d6;
  color: #7a5a00;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  font-size: 23rpx;
  margin-bottom: 18rpx;
}

.banner-action {
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.next-card {
  border-radius: 30rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 22rpx;
  color: #22221f;
}

.next-eyebrow {
  font-size: 21rpx;
  opacity: 0.62;
}

.next-name {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-top: 8rpx;
  word-break: break-all;
}

.next-meta {
  font-size: 24rpx;
  opacity: 0.72;
  margin-top: 8rpx;
}

.next-countdown {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  font-weight: 500;
}

.all-done {
  background: var(--card);
  border-radius: 24rpx;
  padding: 26rpx;
  font-size: 25rpx;
  color: var(--muted);
  margin-bottom: 22rpx;
}

.empty-card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 40rpx 28rpx;
  text-align: center;
}

.empty-actions {
  display: flex;
  margin-top: 26rpx;
}

.empty-actions .ghost-btn,
.empty-actions .primary-btn {
  flex: 1;
}

.empty-actions .ghost-btn {
  margin-right: 16rpx;
}

.today-item {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 22rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.today-time {
  width: 104rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  font-size: 19rpx;
  line-height: 1.4;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.today-main {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
}

.today-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
  word-break: break-all;
}

.today-meta {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 19rpx;
}

.status.upcoming {
  background: #eef3ff;
  color: #3b5bdb;
}

.status.ongoing {
  background: #e6f7e9;
  color: #2b7a3d;
}

.status.past {
  background: #f1f1ec;
  color: #9a9a94;
}
