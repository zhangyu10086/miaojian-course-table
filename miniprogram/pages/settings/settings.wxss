.settings-page {
  padding: 24rpx 24rpx 60rpx;
}

.form-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 4rpx 26rpx 10rpx;
  margin-bottom: 20rpx;
}

.form-title-block {
  padding: 26rpx 0 10rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 700;
}

.form-hint {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 4rpx;
  line-height: 1.5;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--line);
}

.form-label {
  width: 170rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--muted);
}

.form-label.inline {
  display: block;
  width: auto;
  color: var(--text);
}

.form-value {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  padding-right: 8rpx;
}

.chevron {
  font-size: 34rpx;
  color: #c3c3bc;
  line-height: 1;
}

.clear-row {
  font-size: 21rpx;
  color: var(--muted);
  text-align: right;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--line);
  text-decoration: underline;
}

.section-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.section-no {
  width: 54rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 600;
}

.time-pill {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: var(--soft);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.time-dash {
  color: var(--muted);
  margin: 0 8rpx;
  font-size: 22rpx;
}

.section-remove {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--muted);
}

.section-actions {
  display: flex;
  padding: 20rpx 0 16rpx;
}

.mini-btn {
  font-size: 22rpx;
  color: var(--text);
  background: var(--soft);
  border-radius: 14rpx;
  padding: 10rpx 18rpx;
  margin-right: 14rpx;
}

.primary-btn {
  margin-top: 12rpx;
}
