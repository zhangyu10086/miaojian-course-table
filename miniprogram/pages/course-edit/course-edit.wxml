<view class="page edit-page">
  <view class="form-card">
    <view class="form-row">
      <text class="form-label">课程名</text>
      <input
        class="form-input"
        value="{{name}}"
        placeholder="例如：高等数学"
        placeholder-class="placeholder"
        maxlength="40"
        bindinput="onNameInput"
      />
    </view>
    <view class="form-row">
      <text class="form-label">教师</text>
      <input
        class="form-input"
        value="{{teacher}}"
        placeholder="选填"
        placeholder-class="placeholder"
        maxlength="30"
        bindinput="onTeacherInput"
      />
    </view>
    <view class="form-row">
      <text class="form-label">地点</text>
      <input
        class="form-input"
        value="{{location}}"
        placeholder="例如：教学楼 A101"
        placeholder-class="placeholder"
        maxlength="50"
        bindinput="onLocationInput"
      />
    </view>
  </view>

  <view class="form-card">
    <view class="slot-head">
      <view class="form-title">上课时间</view>
      <view class="form-hint">可以添加多个时间段，节次可以不同</view>
    </view>

    <view wx:for="{{slots}}" wx:key="key" class="slot-row">
      <picker
        mode="selector"
        range="{{days}}"
        value="{{item.dayIndex}}"
        data-index="{{index}}"
        bindchange="onSlotDayChange"
      >
        <view class="slot-picker">{{days[item.dayIndex]}}</view>
      </picker>

      <picker
        mode="selector"
        range="{{sectionLabels}}"
        value="{{item.startIndex}}"
        data-index="{{index}}"
        bindchange="onSlotStartChange"
      >
        <view class="slot-picker">第 {{item.startSection}} 节</view>
      </picker>

      <text class="slot-dash">-</text>

      <picker
        mode="selector"
        range="{{sectionLabels}}"
        value="{{item.endIndex}}"
        data-index="{{index}}"
        bindchange="onSlotEndChange"
      >
        <view class="slot-picker">第 {{item.endSection}} 节</view>
      </picker>

      <text
        wx:if="{{slots.length > 1}}"
        class="slot-remove"
        data-index="{{index}}"
        catchtap="onRemoveSlot"
      >删除</text>
    </view>

    <view class="slot-add" bindtap="onAddSlot">+ 添加时间段</view>

    <view wx:if="{{isEdit && groupCount > 1}}" class="sync-row" bindtap="onToggleSyncGroup">
      <text class="sync-box {{syncGroup ? 'checked' : ''}}">{{syncGroup ? '✓' : ''}}</text>
      <text class="sync-text">同时修改这门课的其他 {{groupCount - 1}} 个时段</text>
    </view>
  </view>

  <view class="form-card">
    <view class="week-head">
      <view>
        <view class="form-title">上课周次</view>
        <view class="form-hint">已选 {{weekCount}} 周</view>
      </view>
      <view class="week-actions">
        <text class="mini-btn" bindtap="onSelectAllWeeks">全选</text>
        <text class="mini-btn" bindtap="onSelectOddWeeks">单周</text>
        <text class="mini-btn" bindtap="onSelectEvenWeeks">双周</text>
        <text class="mini-btn" bindtap="onClearWeeks">清空</text>
      </view>
    </view>
    <view class="week-grid">
      <view
        wx:for="{{weekChips}}"
        wx:key="week"
        class="week-chip {{item.selected ? 'selected' : ''}}"
        data-index="{{index}}"
        bindtap="onWeekToggle"
      >
        {{item.week}}
      </view>
    </view>
  </view>

  <view class="form-card">
    <view class="form-title">课程颜色</view>
    <view class="color-row">
      <view
        wx:for="{{colors}}"
        wx:key="*this"
        class="color-dot {{index === colorIndex ? 'selected' : ''}}"
        style="background: {{item}};"
        data-index="{{index}}"
        bindtap="onColorSelect"
      ></view>
    </view>
  </view>

  <view class="form-card">
    <view class="form-row">
      <text class="form-label">学分</text>
      <input
        class="form-input"
        type="digit"
        value="{{credit}}"
        placeholder="选填"
        placeholder-class="placeholder"
        bindinput="onCreditInput"
      />
    </view>
    <view class="remark-row">
      <text class="form-label">备注</text>
      <textarea
        class="textarea"
        value="{{remark}}"
        placeholder="考试信息、作业要求等，选填"
        placeholder-class="placeholder"
        maxlength="300"
        auto-height
        bindinput="onRemarkInput"
      ></textarea>
    </view>
  </view>

  <view class="save-area">
    <view class="primary-btn" bindtap="onSave">保存课程</view>
    <view wx:if="{{isEdit}}" class="delete-btn danger-text" bindtap="onDelete">删除这门课</view>
  </view>
</view>
