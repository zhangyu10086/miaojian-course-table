.edit-page {
  padding: 24rpx 24rpx 60rpx;
}

.form-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 4rpx 26rpx;
  margin-bottom: 20rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--line);
}

.form-card > .form-row:last-child,
.form-card > picker:last-child .form-row,
.form-card > .remark-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--muted);
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 28rpx;
  text-align: right;
  padding: 0;
}

.form-value {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  padding-right: 8rpx;
}

.chevron {
  font-size: 34rpx;
  color: #c3c3bc;
  line-height: 1;
}

.placeholder {
  color: #b9b9b2;
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
}

.form-hint {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.week-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 26rpx 0 8rpx;
}

.week-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.mini-btn {
  font-size: 21rpx;
  color: var(--muted);
  background: var(--soft);
  border-radius: 14rpx;
  padding: 6rpx 12rpx;
  margin-left: 8rpx;
}

.week-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx 0 24rpx;
}

.week-chip {
  width: 8.4%;
  margin: 0.8%;
  height: 62rpx;
  border-radius: 14rpx;
  background: var(--soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
}

.week-chip.selected {
  background: var(--accent);
  color: #fff;
}

.color-row {
  display: flex;
  flex-wrap: wrap;
  padding: 22rpx 0 26rpx;
}

.color-dot {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  margin: 0 16rpx 16rpx 0;
  box-sizing: border-box;
}

.color-dot.selected {
  box-shadow: 0 0 0 4rpx #1f1f1c;
  transform: scale(0.92);
}

.remark-row {
  display: flex;
  padding: 24rpx 0;
}

.textarea {
  flex: 1;
  min-height: 120rpx;
  font-size: 27rpx;
  line-height: 1.5;
  padding: 0;
}

.save-area {
  margin-top: 34rpx;
}

.delete-btn {
  text-align: center;
  font-size: 25rpx;
  padding: 26rpx 0 10rpx;
}

.slot-head {
  margin-bottom: 14rpx;
}

.slot-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.slot-picker {
  padding: 16rpx 14rpx;
  background: var(--soft);
  border-radius: 12rpx;
  font-size: 25rpx;
}

.slot-row > picker {
  margin-right: 10rpx;
}

.slot-dash {
  margin-right: 10rpx;
  color: var(--muted);
}

.slot-remove {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--danger);
}

.slot-add {
  padding: 18rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--text);
  border: 1rpx dashed var(--line);
  border-radius: 14rpx;
}

.sync-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.sync-box {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  font-size: 22rpx;
  margin-right: 12rpx;
}

.sync-box.checked {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.sync-text {
  font-size: 23rpx;
  color: var(--muted);
}

.week-now {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  margin-bottom: 14rpx;
  background: var(--soft);
  border-radius: 12rpx;
}

.week-now-text {
  font-size: 22rpx;
  color: var(--muted);
}

.week-now-btn {
  font-size: 22rpx;
  color: var(--text);
  text-decoration: underline;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.date-label {
  font-size: 24rpx;
  color: var(--muted);
}

.date-value {
  font-size: 24rpx;
  color: var(--text);
}

.date-value.disabled {
  color: var(--muted);
}

.picked-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  margin-bottom: 14rpx;
  background: #e8f2ea;
  border-radius: 12rpx;
}

.picked-text {
  font-size: 22rpx;
  color: #2f6b45;
}

.picked-link {
  font-size: 22rpx;
  color: #2f6b45;
  text-decoration: underline;
}

.week-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

.chip-week {
  font-size: 25rpx;
  line-height: 1.2;
}

.chip-date {
  font-size: 17rpx;
  color: var(--muted);
  line-height: 1.3;
}

.week-chip.selected .chip-date {
  color: rgba(255, 255, 255, 0.85);
}
