.admin-page {
  padding: 28rpx 24rpx 60rpx;
}

.admin-head {
  padding: 0 6rpx 24rpx;
}

.admin-title {
  font-size: 40rpx;
  font-weight: 700;
}

.admin-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  line-height: 1.5;
}

.admin-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx 26rpx;
}

.admin-status {
  font-size: 26rpx;
  color: var(--muted);
  text-align: center;
  padding: 50rpx 26rpx;
}

.admin-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 24rpx;
}

.openid-box {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  padding: 16rpx 18rpx;
  background: var(--soft);
  border-radius: 14rpx;
}

.openid-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  word-break: break-all;
}

.copy-link {
  flex-shrink: 0;
  margin-left: 14rpx;
  padding: 6rpx 10rpx;
  font-size: 22rpx;
  color: var(--text);
  text-decoration: underline;
}

.copy-hint {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 10rpx;
}

.admin-steps {
  margin-top: 22rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.9;
}

.admin-btn {
  margin-top: 24rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--muted);
  margin: 22rpx 0 10rpx;
}

.field-label:first-child {
  margin-top: 0;
}

.field-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 18rpx;
  font-size: 27rpx;
  background: var(--soft);
  border-radius: 14rpx;
}

.field-textarea {
  width: 100%;
  min-height: 260rpx;
  padding: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
  background: var(--soft);
  border-radius: 14rpx;
  box-sizing: border-box;
}

.field-count {
  text-align: right;
  font-size: 20rpx;
  color: var(--muted);
  margin: 8rpx 4rpx 24rpx;
}

.field-hint {
  font-size: 20rpx;
  color: var(--muted);
  margin: 8rpx 4rpx 0;
}

.publish-btn {
  margin-top: 30rpx;
}

.admin-section-title {
  font-size: 27rpx;
  font-weight: 600;
  margin: 34rpx 6rpx 14rpx;
}

.manage-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
}

.manage-head {
  display: flex;
  align-items: flex-start;
}

.manage-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  font-weight: 600;
}

.manage-pin {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: #fff3d6;
  color: #9a5b00;
  font-size: 18rpx;
}

.manage-meta {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.manage-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.manage-btn {
  font-size: 21rpx;
  color: var(--text);
  background: var(--soft);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  margin-left: 10rpx;
}

.admin-foot {
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 22rpx;
}
