<view class="page detail-page">
  <view wx:if="{{loading}}" class="state">
    <view class="state-desc">正在加载…</view>
  </view>

  <view wx:elif="{{error}}" class="state">
    <view class="state-title">加载失败</view>
    <view class="state-desc">{{error}}</view>
    <view class="ghost-btn state-btn" bindtap="onRetry">重试</view>
  </view>

  <block wx:else>
    <view class="detail-card">
      <view class="detail-head">
        <view class="detail-title-row">
          <text wx:if="{{notice.pinned}}" class="pin-tag">置顶</text>
          <text class="detail-title">{{notice.title}}</text>
        </view>

        <view class="detail-meta">
          <text>{{notice.source}}</text>
          <text class="sep">·</text>
          <text>{{notice.datetimeLabel}}</text>
          <text class="sep">·</text>
          <text>{{notice.views}} 次浏览</text>
        </view>

        <view wx:if="{{notice.hasUpdate}}" class="detail-updated">
          更新于 {{notice.updatedDatetimeLabel}}
        </view>
      </view>

      <view class="detail-divider"></view>

      <view wx:if="{{!blocks.length}}" class="detail-content">暂无内容</view>
      <view wx:else class="md-body">
        <block
          wx:for="{{blocks}}"
          wx:for-item="block"
          wx:for-index="blockIndex"
          wx:key="key"
        >
          <view wx:if="{{block.type === 'heading'}}" class="md-heading md-h{{block.level}}">
            <text
              wx:for="{{block.parts}}"
              wx:for-item="part"
              wx:for-index="partIndex"
              wx:key="key"
              class="{{part.bold ? 'md-bold' : ''}}"
            >{{part.text}}</text>
          </view>

          <view wx:elif="{{block.type === 'quote'}}" class="md-quote">
            <text
              wx:for="{{block.parts}}"
              wx:for-item="part"
              wx:for-index="partIndex"
              wx:key="key"
              class="{{part.bold ? 'md-bold' : ''}}"
            >{{part.text}}</text>
          </view>

          <view wx:elif="{{block.type === 'list'}}" class="md-list">
            <view
              wx:for="{{block.items}}"
              wx:for-item="li"
              wx:for-index="liIndex"
              wx:key="key"
              class="md-li"
              style="padding-left: {{li.level * 28}}rpx;"
            >
              <text class="md-bullet">{{block.ordered ? (li.number + '.') : '•'}}</text>
              <view class="md-li-body">
                <text
                  wx:for="{{li.parts}}"
                  wx:for-item="part"
                  wx:for-index="partIndex"
                  wx:key="key"
                  class="{{part.bold ? 'md-bold' : ''}}"
                >{{part.text}}</text>
              </view>
            </view>
          </view>

          <view wx:else class="md-p">
            <text
              wx:for="{{block.parts}}"
              wx:for-item="part"
              wx:for-index="partIndex"
              wx:key="key"
              class="{{part.bold ? 'md-bold' : ''}}"
            >{{part.text}}</text>
          </view>
        </block>
      </view>
    </view>

    <view wx:if="{{notice.qqGroup}}" class="group-card">
      <view class="group-main">
        <text class="group-label">交流群</text>
        <text class="group-number" selectable>{{notice.qqGroup}}</text>
      </view>
      <view class="group-copy" bindtap="onCopyGroup">复制群号</view>
    </view>

    <view class="detail-foot">秒见课表 · 公告</view>
  </block>
</view>
