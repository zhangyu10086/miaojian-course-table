.sync-page {
  padding: 28rpx 24rpx 60rpx;
}

.hero {
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.hero-sub {
  font-size: 23rpx;
  color: var(--muted);
  margin-top: 8rpx;
  line-height: 1.5;
}

.banner {
  background: #fff4d6;
  color: #7a5a00;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  font-size: 23rpx;
  line-height: 1.5;
  margin-bottom: 18rpx;
}

.notice-card {
  background: #fff4d6;
  color: #6b4e00;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 18rpx;
}

.notice-title {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.notice-line {
  font-size: 22rpx;
  line-height: 1.7;
}

.form-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 4rpx 26rpx;
  margin-bottom: 26rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid var(--line);
}

.row-hover {
  opacity: 0.6;
}

.form-card > .form-row:last-child,
.form-card > picker:last-child .form-row {
  border-bottom: none;
}

.form-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--muted);
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 27rpx;
  text-align: right;
  padding: 0;
}

.form-value {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  padding-right: 8rpx;
}

.chevron {
  font-size: 34rpx;
  color: #c3c3bc;
  line-height: 1;
}

.placeholder {
  color: #b9b9b2;
}

.password-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.password-input {
  flex: 1;
}

.eye {
  font-size: 22rpx;
  color: var(--muted);
  padding: 10rpx 0 10rpx 16rpx;
  flex-shrink: 0;
}

.switch-row {
  justify-content: space-between;
}

.switch-label {
  display: block;
  font-size: 27rpx;
}

.switch-hint {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

.manual-only-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 30rpx 26rpx;
  margin-top: 20rpx;
}

.manual-only-title {
  font-size: 28rpx;
  font-weight: 600;
}

.manual-only-desc {
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.7;
  margin-top: 10rpx;
}

.manual-only-btn {
  margin-top: 26rpx;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 6rpx 22rpx;
}

.agree-box {
  width: 30rpx;
  height: 30rpx;
  border-radius: 8rpx;
  border: 1rpx solid #c3c3bc;
  margin: 4rpx 12rpx 0 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
}

.agree-box.checked {
  background: var(--accent);
  border-color: var(--accent);
}

.agree-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}

.agree-link {
  color: var(--text);
  text-decoration: underline;
}

.primary-btn {
  margin-top: 8rpx;
}

.primary-btn.loading {
  opacity: 0.6;
}

.tips {
  margin-top: 30rpx;
  padding: 0 6rpx;
}

.tip {
  display: flex;
  align-items: flex-start;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.tip-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #c9c9c2;
  margin: 12rpx 12rpx 0 0;
  flex-shrink: 0;
}

.help-link {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  text-decoration: underline;
  margin-top: 30rpx;
}
