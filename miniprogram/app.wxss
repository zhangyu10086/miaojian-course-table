page {
  --bg: #f7f7f2;
  --card: #ffffff;
  --text: #1f1f1c;
  --muted: #8b8b86;
  --line: #e9e9e2;
  --soft: #efefe8;
  --accent: #1f1f1c;
  --danger: #c4473a;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Microsoft YaHei', 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji',
    sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
input,
textarea,
button,
picker,
switch,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx;
}

.muted {
  color: var(--muted);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 0 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row + .row {
  margin-top: 24rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

.primary-btn {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: var(--accent);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.primary-btn[disabled] {
  opacity: 0.4;
}

.ghost-btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: var(--soft);
  color: var(--text);
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

.danger-text {
  color: var(--danger);
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--muted);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 25rpx;
  line-height: 1.6;
}
